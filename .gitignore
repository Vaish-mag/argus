__pycache__/
*.pyc
.venv/
.claude/

# generated by `run_argus.py init-golden` from the local web root -- machine-specific,
# and regenerating it is a documented setup step, so it does not belong in the repo
config/golden_manifest.json

# generated at runtime / during experiments -- keep the folders, not their contents
runtime/*
!runtime/.gitkeep
results/*
!results/.gitkeep
results/forensics/*
!results/forensics/.gitkeep
